# This file documents the path layout expected by the archived paper scripts.
# The scripts are the exact experiment scripts and many contain /workspace defaults.
# Either pass their CLI path arguments where available or edit the constants locally.

AVERIMATEC_REPO=/absolute/path/to/AVerImaTec_Shared_Task
XXP_REPO=/absolute/path/to/FEVER-9-AVerImaTeC-XxP
VAL_IMAGES=/absolute/path/to/validation/images
TEST_IMAGES=/absolute/path/to/test/images
VAL_KNOWLEDGE_STORE=/absolute/path/to/validation/knowledge_store
TEST_KNOWLEDGE_STORE=/absolute/path/to/test/knowledge_store
HF_HOME=/absolute/path/to/huggingface/cache
OUTPUT_ROOT=/absolute/path/to/vacf_outputs
